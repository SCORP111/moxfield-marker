{
  "manifest_version": 2,
  "name": "Moxfield-Marker",
  "version": "1.1.0",
  "description": "Karten in Moxfield-Decks farblich markieren. Markierungen werden pro Deck lokal im Browser gespeichert.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://moxfield.com/*", "https://www.moxfield.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{9db7b7ab-c23e-4c18-bd0a-511681a71990}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
